generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum CompanyLifecycle {
  LEAD
  CONTACTED
  QUALIFIED
  OPPORTUNITY
  CLIENT
  INACTIVE
  LOST
}

enum OpportunityStage {
  TO_QUALIFY
  TO_CONTACT
  CONTACTED
  INTERESTED
  MEETING
  QUOTE
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum Priority {
  LOW
  NORMAL
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  WAITING_CLIENT
  REVIEW
  COMPLETED
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  MESSAGE
  NOTE
  QUOTE
  PAYMENT
  OTHER
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum InteractionResult {
  NO_ANSWER
  GATEKEEPER
  CALLBACK
  INTERESTED
  NOT_INTERESTED
  MEETING_BOOKED
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum CalendarEventType {
  CALL
  FOLLOW_UP
  MEETING
  TASK
  DEADLINE
  DELIVERY
  MAINTENANCE
  ADMINISTRATIVE
}

enum DocumentType {
  QUOTE
  PROPOSAL
  INVOICE
  CONTRACT
  ASSET
  OTHER
}

enum MaintenanceStatus {
  ACTIVE
  PAUSED
  ENDED
  CANCELED
}

enum MilestoneStatus {
  PENDING
  DONE
  CANCELED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdInteractions Interaction[]              @relation("InteractionCreatedBy")
  assignedTasks       Task[]                     @relation("TaskAssignee")
  stageChanges        OpportunityStageHistory[]  @relation("StageChangedBy")
  activityLogs        ActivityLog[]              @relation("ActivityLogActor")
}

model Company {
  id                  String           @id @default(cuid())
  name                String
  lifecycleStatus     CompanyLifecycle
  industry            String?
  website             String?
  phone               String?
  email               String?
  address             String?
  city                String?
  postalCode          String?
  country             String?          @default("FR")
  source              String?
  qualificationScore  Int?
  priority            Priority         @default(NORMAL)
  description         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  contacts              Contact[]
  interactions          Interaction[]
  followUps             FollowUp[]
  opportunities         Opportunity[]
  quotes                Quote[]
  projects              Project[]
  tasks                 Task[]
  calendarEvents        CalendarEvent[]
  documents             Document[]
  payments              Payment[]
  maintenanceContracts  MaintenanceContract[]

  @@index([name])
  @@index([lifecycleStatus])
  @@index([industry])
  @@index([city])
}

model Contact {
  id               String   @id @default(cuid())
  companyId        String
  firstName        String
  lastName         String
  role             String?
  phone            String?
  email            String?
  preferredChannel String?
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interactions   Interaction[]
  followUps      FollowUp[]
  calendarEvents CalendarEvent[]
}

model Interaction {
  id             String               @id @default(cuid())
  companyId      String
  contactId      String?
  opportunityId  String?
  type           InteractionType
  direction      InteractionDirection
  result         InteractionResult?
  subject        String?
  notes          String?
  occurredAt     DateTime
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("InteractionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  followUps    FollowUp[]

  @@index([companyId, occurredAt])
}

model FollowUp {
  id                  String         @id @default(cuid())
  companyId           String
  opportunityId       String?
  contactId           String?
  title               String
  dueAt               DateTime
  status              FollowUpStatus @default(PENDING)
  priority            Priority       @default(NORMAL)
  completedAt         DateTime?
  sourceInteractionId String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  company           Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunity       Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact           Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sourceInteraction Interaction? @relation(fields: [sourceInteractionId], references: [id], onDelete: SetNull)

  @@index([dueAt])
  @@index([status])
}

model Opportunity {
  id                String           @id @default(cuid())
  companyId         String
  title             String
  stage             OpportunityStage
  estimatedValue    Decimal          @db.Decimal(12, 2)
  probability       Int              @default(0)
  source            String?
  lostReason        String?
  expectedCloseDate DateTime?
  wonAt             DateTime?
  lostAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interactions   Interaction[]
  followUps      FollowUp[]
  stageHistory   OpportunityStageHistory[]
  quotes         Quote[]
  projects       Project[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  documents      Document[]

  @@index([stage])
  @@index([companyId])
}

model OpportunityStageHistory {
  id          String           @id @default(cuid())
  opportunityId String
  fromStage   OpportunityStage?
  toStage     OpportunityStage
  changedAt   DateTime         @default(now())
  changedById String

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  changedBy   User        @relation("StageChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
}

model Quote {
  id             String      @id @default(cuid())
  companyId      String
  opportunityId  String
  projectId      String?
  reference      String      @unique
  amountExTax    Decimal?    @db.Decimal(12, 2)
  amountTax      Decimal?    @db.Decimal(12, 2)
  amountIncTax   Decimal     @db.Decimal(12, 2)
  status         QuoteStatus @default(DRAFT)
  sentAt         DateTime?
  acceptedAt     DateTime?
  externalUrl    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payments    Payment[]
}

model Project {
  id             String        @id @default(cuid())
  companyId      String
  opportunityId  String?
  name           String
  status         ProjectStatus @default(PLANNED)
  description    String?
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  amount         Decimal?      @db.Decimal(12, 2)
  progress       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunity          Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  quotes               Quote[]
  tasks                Task[]
  milestones           Milestone[]
  repositories         Repository[]
  calendarEvents       CalendarEvent[]
  documents            Document[]
  payments             Payment[]
  maintenanceContracts MaintenanceContract[]

  @@index([status])
  @@index([dueDate])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(NORMAL)
  dueAt          DateTime?
  completedAt    DateTime?
  companyId      String?
  opportunityId  String?
  projectId      String?
  assignedToId   String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo   User          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  calendarEvents CalendarEvent[]

  @@index([dueAt])
  @@index([status])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  dueAt       DateTime?
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
}

model Repository {
  id            String    @id @default(cuid())
  projectId     String
  provider      String
  owner         String
  name          String
  url           String
  defaultBranch String    @default("main")
  externalId    String?
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([provider, owner, name])
}

model CalendarEvent {
  id               String            @id @default(cuid())
  title            String
  type             CalendarEventType
  startsAt         DateTime
  endsAt           DateTime
  allDay           Boolean           @default(false)
  companyId        String?
  contactId        String?
  opportunityId    String?
  projectId        String?
  taskId           String?
  externalProvider String?
  externalId       String?
  syncStatus       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model Document {
  id            String       @id @default(cuid())
  name          String
  type          DocumentType
  url           String
  companyId     String?
  opportunityId String?
  projectId     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Payment {
  id                String        @id @default(cuid())
  companyId         String
  projectId         String?
  quoteId           String?
  label             String
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  dueAt             DateTime?
  paidAt            DateTime?
  externalReference String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quote   Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
}

model MaintenanceContract {
  id            String            @id @default(cuid())
  companyId     String
  projectId     String?
  monthlyAmount Decimal           @db.Decimal(12, 2)
  status        MaintenanceStatus @default(ACTIVE)
  startDate     DateTime
  endDate       DateTime?
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("ActivityLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}
