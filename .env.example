# Database
# Copy this file to `.env` and replace the placeholder with a real PostgreSQL URL.
# Never commit `.env` or real credentials.
DATABASE_URL="postgresql://versatech:CHANGE_ME@localhost:5432/versatech_os"

# GitHub (optional, server-side only — never expose to the browser)
# Fine-grained or classic PAT with read access to linked repositories (contents: read).
# Leave empty to associate repositories without live activity (branch/commits/pushed_at).
GITHUB_TOKEN=""

# Auth — required for login sessions (H11).
# Generate AUTH_SECRET with: openssl rand -base64 32
# Never expose AUTH_SECRET or AUTH_DEV_PASSWORD to the browser.
AUTH_SECRET="replace-me-with-a-random-string-of-at-least-32-chars"

# Local seed / set-dev-password only. Not a production account, no public signup.
AUTH_DEV_EMAIL="camille.durand@versatech.example"
AUTH_DEV_PASSWORD="versatech-dev-local"

# Destructive development seed (prisma/seed.ts deletes ALL CRM rows, including real clients).
# Default is false. Never set true on a database that contains ALEX'CEPTION or other real data.
# The seed also refuses to run when NODE_ENV=production, even if this flag is true.
ALLOW_DESTRUCTIVE_SEED="false"

# Demo / E2E cleanup (prisma/cleanup-demo-data.ts). Default is dry-run (no deletes).
# Never set true until the explicit company ID allowlist has been reviewed.
# The script also refuses to run when NODE_ENV=production, even if this flag is true.
ALLOW_DEMO_CLEANUP="false"

# Additive terrain prospect import (prisma/import-terrain-prospects.ts).
# Default is false. Production refuses unless this is explicitly true.
# Idempotent: re-running does not create duplicates and never mutates ALEX'CEPTION.
# Never use ALLOW_DESTRUCTIVE_SEED for this import.
ALLOW_TERRAIN_PROSPECT_IMPORT="false"

# Nominatim (OpenStreetMap) — server-side geocoding only, never on map render.
# Required by Nominatim usage policy: identifiable User-Agent with a contact.
# Leave empty to disable geocoding; operators can still enter lat/lng manually.
# Example: VersaTech OS CRM (ops@versatech.example)
NOMINATIM_USER_AGENT=""

# Idempotent geocode of companies missing coordinates (prisma/geocode-missing-companies.ts).
# Never invents lat/lng. Skips ALEX'CEPTION. Production refuses unless this is true.
ALLOW_GEOCODE_MISSING_COMPANIES="false"

# VersaTech AI (server-only — never expose to the browser, prompts, or ActivityLog).
# Mastra model router is built into @mastra/core; swap provider without rewriting tools.
# Leave keys empty until chat is enabled. Never commit real secrets.
VERSATECH_AI_PROVIDER="openai"
VERSATECH_AI_MODEL="gpt-5-mini"
OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_API_KEY=""
